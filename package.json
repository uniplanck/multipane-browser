{
  "name": "multipane-browser",
  "productName": "xG-Bots",
  "version": "1.0.0",
  "description": "1ウィンドウに最大10ペインを並べられるChromiumベースのブラウザ",
  "main": "src/main.js",
  "scripts": {
    "build:preload": "node scripts/build-pane-preload.js",
    "check:preload": "node scripts/build-pane-preload.js --check",
    "prestart": "node scripts/build-pane-preload.js --check",
    "start": "electron .",
    "dist:mac": "electron-builder --mac --universal",
    "dist:mac-split": "electron-builder --mac --arm64 --x64",
    "install:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 -c.mac.identity=null && codesign --force --deep -s - 'dist/mac-arm64/xG-Bots.app' && rm -rf '/Applications/xG-Bots.app' && ditto 'dist/mac-arm64/xG-Bots.app' '/Applications/xG-Bots.app'"
  },
  "build": {
    "appId": "com.multipanebrowser.app",
    "productName": "xG-Bots",
    "beforePack": "./scripts/build-pane-preload.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}